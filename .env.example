# Demo Mode needs no configuration. Copy to .env.local only for live AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Live requests remain disabled until explicitly enabled server-side.
ENABLE_LIVE_AI=false
# Comma-separated module IDs to disable in both navigation and API routes.
# chat,agents,knowledge,vision,voice,workflows,analytics
NEXT_PUBLIC_DISABLED_FEATURES=
