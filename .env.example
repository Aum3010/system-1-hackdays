# Keep secrets server-side. Copy this file to .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Laya's real typed-decision HTTP server, local or hosted on Hugging Face.
# Leave blank to use the deterministic decision engine automatically.
LAYA_ENDPOINT=
LAYA_MODEL=convaiinnovations/laya
LAYA_API_KEY=
HUGGINGFACE_API_TOKEN=
LAYA_TIMEOUT_MS=2500
# Fighter-profile budget (250-30000). Local CPU laya-serve needs about 12000 (see README and docs/LAYA.md).
